# --- Bắt buộc ---
# Khoá bí mật dùng ký JWT + mã hoá secret trong DB (sinh: openssl rand -hex 32)
TH_SECRET_KEY=change-me
TH_DB_PASSWORD=change-me
# Tài khoản admin khởi tạo (chỉ dùng lần chạy đầu)
TH_ADMIN_EMAIL=admin@example.com
TH_ADMIN_PASSWORD=change-me

# Thư mục dữ liệu của control plane (apps, backups, caddy, db)
TH_DATA_DIR=/data/application/tekar-hosting/data
# Thư mục gốc chứa các dự án compose đã có (để phát hiện + adopt)
TH_APPS_ROOT=/data/application
# Gốc lưu trữ mount vào panel (cùng đường dẫn). Thư mục apps/backup/volume/data cấu hình trong panel phải nằm dưới đây.
TH_STORAGE_ROOT=/data
# Owner (uid:gid) cho file compose/.env panel ghi ra, để sửa được trên host. Bỏ trống = theo thư mục cha.
TH_STORAGE_OWNER=

# --- Cổng ---
TH_PANEL_PORT=9900
TH_PANEL_BIND=0.0.0.0
# Dải IP của reverse proxy đứng trước panel (mạng docker th-edge của Caddy, mạng của NPM nếu còn dùng).
# Chỉ các nguồn này được tin X-Forwarded-For; để trống = 172.16.0.0/12. Xem: docker network inspect th-edge
#TH_TRUSTED_PROXIES=172.16.0.0/12,192.168.64.0/20
# Bật Swagger /api/docs (mặc định tắt)
#TH_API_DOCS=true
# NPM đang giữ 80/443 nên Caddy chạy cổng phụ; traffic public đi qua Cloudflare Tunnel
TH_CADDY_HTTP_PORT=8880
TH_CADDY_HTTPS_PORT=8843

# --- Tuỳ chọn ---
# Đường dẫn DB của Nginx Proxy Manager để import proxy host
TH_NPM_SQLITE=/data/application/proxy/data/database.sqlite
